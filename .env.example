# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form endpoint. Any service that accepts a JSON POST works
# (e.g. Formspree: https://formspree.io/f/xxxxxxx). Leave empty and the
# form will tell visitors it is not connected and offer Telegram / X instead.
NEXT_PUBLIC_FORM_ENDPOINT=
